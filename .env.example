OPENAI_API_KEY=
TIER1_SUPERVISOR_MODEL=gpt-4o-mini
TIER1_SPECIALIST_MODEL=gpt-5.1-mini
ACTIVE_TIER=1

# Tier 2 and Tier 3 execution
GROQ_API_KEY=
TIER2_SUPERVISOR_MODEL=openai/gpt-oss-120b
TIER2_SPECIALIST_MODEL=openai/gpt-oss-20b
TIER3_WORKER_MODEL=openai/gpt-oss-20b

# Optional Tier 3 intent router. Missing key degrades to Tier 2 Groq.
LAYA_API_KEY=
LAYA_BASE_URL=https://api.laya.ai
TIER3_ROUTER_MODEL=laya-classifier-v1
TIER3_CONFIDENCE_THRESHOLD=0.85

JWT_SECRET=
APP_DB_URL=postgresql://postgres:root@localhost:5432/insureagent
MEMORY_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000